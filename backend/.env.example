# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB Atlas ----
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/donate_bharat?retryWrites=true&w=majority

# ---- Auth ----
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ---- File storage: 's3' or 'local' ----
STORAGE_DRIVER=local
# When STORAGE_DRIVER=s3:
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
# URL the presigned/S3 objects resolve to (leave blank to use region endpoint)
AWS_ENDPOINT=
# Local fallback path when STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
# Max signed-URL validity for private file downloads (seconds)
SIGNED_URL_TTL=300

# ---- Razorpay (https://dashboard.razorpay.com) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (nodemailer SMTP). Use a dev transport if left blank. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Donate Bharat <noreply@example.com>"

# ---- Admin bootstrap (created by seed / on boot when users table is empty) ----
ADMIN_EMAIL=admin@donatebharat.in
ADMIN_PASSWORD=Admin@123456
